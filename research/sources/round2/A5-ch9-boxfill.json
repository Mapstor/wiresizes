 {
  "ref": "314.16(B)(1)-(5)",
  "note": "2023 has (B)(1) through (B)(6). Text joins verbatim segments with ' … ' (words may be missing at a boundary).",
  "rules": [
   {
    "item": "(B) intro",
    "edition": "2020",
    "status": "VERIFIED-other-edition",
    "source": "P8",
    "text": "The volumes in paragraphs 314.16(B)(1) through (B)(5), as applicable, shall be added together. … No allowance shall be required for small fittings such as locknuts and bushings. … Each space within a box installed with a barrier shall be calculated separately."
   },
   {
    "item": "(B) intro",
    "edition": "2026 First Draft",
    "status": "VERIFIED-draft",
    "source": "N1 FR-7529",
    "text": "The volumes in 314.16(B)(1) through (B)(6), as applicable, shall be added together.",
    "change": "adds 'splicing connectors' to small fittings needing no allowance"
   },
   {
    "item": "(1)",
    "title": "Conductor Fill",
    "edition": "2011",
    "status": "VERIFIED-other-edition",
    "status_2023": "UNVERIFIED",
    "source": "P1",
    "text": "Each conductor that originates outside the box and terminates or is spliced within the box … each conductor that passes through the box without splice or termination shall be counted once. … Each loop or coil of unbroken conductor not less than twice the minimum length required for free … conductors in 300.14 shall be counted twice. … A conductor, no part of which leaves the box, shall not be counted."
   },
   {
    "item": "(1) exception",
    "edition": "2011",
    "status": "VERIFIED-other-edition",
    "status_2023": "UNVERIFIED",
    "source": "P1",
    "text": "An equipment grounding conductor or conductors not over four fixture wires smaller than #14 AWG … shall be permitted to be omitted from the calculations where they enter a box from a domed luminaire … and terminate within that box."
   },
   {
    "item": "(2)",
    "title": "Clamp Fill",
    "edition": "2011",
    "status": "VERIFIED-other-edition",
    "status_2023": "UNVERIFIED",
    "source": "P1",
    "text": "Where one or more internal cable clamps, whether factory or field supplied, are present in the box, … a single volume allowance in accordance with Table 314.16(B) shall be made … based on the largest conductor present in the box. … No allowance shall be required for a cable connector with its clamping mechanism outside the box."
   },
   {
    "item": "(3)",
    "title": "Support Fittings Fill",
    "edition": "2011",
    "status": "VERIFIED-other-edition",
    "status_2023": "UNVERIFIED",
    "source": "P1",
    "text": "Where one or more luminaire studs or hickeys are present in the box, … a single volume allowance in accordance with Table 314.16(B) … shall be made for each type of fitting based on the largest conductor present in the box."
   },
   {
    "item": "(4)",
    "title": "Device or Equipment Fill",
    "edition": "2011",
    "status": "VERIFIED-other-edition",
    "status_2023": "UNVERIFIED",
    "source": "P1",
    "text": "For each yoke or strap containing one or more devices or equipment, a double volume allowance … in accordance with Table 314.16(B) shall be made for each yoke or strap based on the largest conductor … connected to a device(s) or equipment supported by that yoke or strap. … A device or utilization equipment wider than a single 50mm (2 in.) device box as described in Table 314.16(A) … shall have double volume allowances provided for each gang required for mounting.",
    "draft_2026": "FR-7525 adds 'Informational Note: See 314.24(B) for additional information on minimum box depth.'"
   },
   {
    "item": "(5)",
    "title": "Equipment Grounding Conductor Fill",
    "edition": "2020",
    "status": "VERIFIED-other-edition",
    "status_2023": "UNVERIFIED",
    "source": "P8",
    "text": "Where up to four equipment grounding conductors or equipment bonding jumpers enter a box, … a single volume allowance in accordance with Table 314.16(B) shall be made based on the largest … A 1/4 volume allowance shall be made for each additional equipment grounding conductor … or equipment bonding jumper that enters the box, based on the largest equipment grounding conductor",
    "superseded_2011_text": "single allowance for all EGCs/EBJs plus an additional allowance for a 250.146(D) isolated-ground set (P1)"
   },
   {
    "item": "(6)",
    "title": "Terminal Block Fill",
    "edition": "2026 First Draft",
    "status": "VERIFIED-draft",
    "exists_in_2023": "VERIFIED (N4: PIs 1617, 1785, 325 filed on 2023 314.16(B)(6))",
    "source": "N1 FR-7527; C2 (category 4, 2023)",
    "text": "Where a terminal block is present in a box, a single volume allowance in accordance with Table 314.16(B)(1) … shall be made for each terminal block assembly based on the largest conductor(s) terminated to the assembly."
   }
  ]
 },
